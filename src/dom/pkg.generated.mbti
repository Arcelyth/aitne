pub fn NestedRoute::to_repr(Self) -> @debug.Repr
pub impl MatchNestedRoutes for NestedRoute
pub impl @debug.Debug for NestedRoute

pub(all) struct NestedRouteView[D] {
  location : Location
  routes : RouteDefs[D]
  outer_owner : @ref.Ref[@reactive.Owner]
