pub(all) struct TemplateView[V](V)
pub fn[V : View + ToTemplate] TemplateView::build(Self[V]) -> RenderState
pub fn[V : View + ToTemplate] TemplateView::html_len(Self[V]) -> Int32
pub fn[V : View + ToTemplate] TemplateView::hydrate(Self[V], Cursor, PositionState) -> RenderState
pub fn[V] TemplateView::new(V) -> Self[V]
pub fn[V : View + ToTemplate] TemplateView::rebuild(Self[V], @ref.Ref[RenderState]) -> Unit
pub fn[V : View + ToTemplate] TemplateView::to_html(Self[V]) -> String
pub fn[V : View + ToTemplate] TemplateView::to_html_with_buf(Self[V], StringBuilder, @ref.Ref[Position]) -> Unit
pub impl[V : View + ToTemplate] Render for TemplateView[V]
pub impl[V : View + ToTemplate] RenderHtml for TemplateView[V]

