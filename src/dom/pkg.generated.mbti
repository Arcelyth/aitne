pub fn[D : MatchNestedRoutes] NestedRouteView::rebuild(Self[D], @ref.Ref[RenderState]) -> Unit
pub fn[D : MatchNestedRoutes] NestedRouteView::style(Self[D], &IntoStyle) -> &View
pub fn[D : MatchNestedRoutes] NestedRouteView::to_html(Self[D]) -> String
pub fn[D : MatchNestedRoutes] NestedRouteView::to_html_with_buf(Self[D], StringBuilder, @ref.Ref[Position]) -> Unit
pub fn[D] NestedRouteView::to_repr(Self[D]) -> @debug.Repr
pub impl[D : MatchNestedRoutes] Render for NestedRouteView[D]
pub impl[D : MatchNestedRoutes] RenderHtml for NestedRouteView[D]
pub impl[D : MatchNestedRoutes] View for NestedRouteView[D]
pub impl[D] @debug.Debug for NestedRouteView[D]

