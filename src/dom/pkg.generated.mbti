pub(all) struct TemplateView[V](V)
pub fn[V] TemplateView::new(V) -> Self[V]
pub impl[V : View + ToTemplate] Render for TemplateView[V]
pub impl[V : View + ToTemplate] RenderHtml for TemplateView[V]

pub struct TextNode {
  val : String
}
pub impl Render for TextNode
pub impl RenderHtml for TextNode
pub impl View for TextNode

pub struct TextState {
  node : @ffi.Text
}

pub(all) struct Url {
  origin : String
  path : String
  search : String
  search_params : Params
  hash : String
} derive(Eq, @debug.Debug)
pub fn Url::current() -> Self
pub fn Url::to_full_path(Self) -> String
pub impl @reactive.TypeName for Url

// Type aliases

// Traits
pub trait Attribute {
  fn html_len(Self) -> Int
  fn to_html(Self, StringBuilder, StringBuilder, StringBuilder, StringBuilder) -> Unit
  fn build(Self, @ffi.Element) -> AttrState
  fn rebuild(Self, @ref.Ref[AttrState]) -> Unit
  fn dry_resolve(Self) -> Unit
  fn hydrate(Self, @ffi.Element) -> AttrState
  fn add_attr(Self, &Attribute) -> &Attribute
}
pub impl Attribute for Unit
pub impl[A : Attribute, B : Attribute] Attribute for (A, B)

pub trait AttributeKey {
  fn get_key(Self) -> String
}
pub impl AttributeKey for String

pub trait AttributeValue {
  fn html_len(Self) -> Int
  fn to_html(Self, String, StringBuilder) -> Unit
  fn build(Self, String, @ffi.Element) -> AttrState
  fn rebuild(Self, String, @ref.Ref[AttrState]) -> Unit
  fn hydrate(Self, @ffi.Element) -> AttrState
  fn dry_resolve(Self) -> Unit
}
pub impl AttributeValue for Unit
pub impl AttributeValue for Bool
pub impl AttributeValue for String

pub trait ElementType {
  fn tag(Self) -> String
  fn is_self_closing(Self) -> Bool
}

pub trait IntoClass {
  fn html_len(Self) -> Int
  fn to_html(Self, StringBuilder) -> Unit
  fn build(Self, @ffi.Element) -> AttrState
  fn rebuild(Self, @ref.Ref[AttrState]) -> Unit
  fn hydrate(Self, @ffi.Element) -> AttrState
  fn dry_resolve(Self) -> Unit
}
pub impl IntoClass for String

pub trait IntoProperty {
  fn html_len(Self) -> Int
  fn to_html(Self, StringBuilder, StringBuilder, StringBuilder, StringBuilder) -> Unit
  fn build(Self, @ffi.Element, String) -> AttrState
  fn rebuild(Self, @ref.Ref[AttrState], String) -> Unit
  fn hydrate(Self, @ffi.Element, String) -> AttrState
  fn dry_resolve(Self) -> Unit
}
pub impl IntoProperty for String
pub impl[S : Show] IntoProperty for @reactive.ReadSignal[S]

pub trait IntoStyle {
  fn html_len(Self) -> Int
  fn to_html(Self, StringBuilder) -> Unit
  fn build(Self, @ffi.Element) -> AttrState
  fn rebuild(Self, @ref.Ref[AttrState]) -> Unit
  fn dry_resolve(Self) -> Unit
  fn hydrate(Self, @ffi.Element) -> AttrState
}
pub impl IntoStyle for String

pub trait MatchNestedRoutes {
  fn match_nested(Self, String) -> ((UInt, NestedMatch)?, String)
}
pub impl MatchNestedRoutes for Unit
pub impl[T : MatchNestedRoutes] MatchNestedRoutes for T?
pub impl[T : MatchNestedRoutes] MatchNestedRoutes for Array[T]

pub trait Mountable {
  fn unmount(Self) -> Unit
  fn mount(Self, @ffi.Node, @ffi.Node) -> Unit
  fn insert_before(Self, &Mountable) -> Bool
  fn elements(Self) -> Array[@ffi.Node]
}

pub trait Render {
  fn build(Self) -> RenderState
  fn rebuild(Self, @ref.Ref[RenderState]) -> Unit
}
pub impl Render for Unit
pub impl Render for String
pub impl Render for Array[&View]

pub trait RenderHtml : Render {
  fn html_len(Self) -> Int
  fn to_html(Self) -> String
  fn to_html_with_buf(Self, StringBuilder, @ref.Ref[Position]) -> Unit
  fn hydrate(Self, Cursor, PositionState) -> RenderState
}
pub impl RenderHtml for Unit
pub impl RenderHtml for String
pub impl RenderHtml for Array[&View]

pub(open) trait ToTemplate {
  fn type_id() -> String
  fn to_template(StringBuilder) -> Unit
}

pub trait View : Render + RenderHtml {
  fn style(Self, &IntoStyle) -> &View
}
pub impl View for Unit
pub impl View for String

